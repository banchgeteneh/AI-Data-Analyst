APP_NAME=AI Data Analyst API
APP_ENV=development
DEBUG=true

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

FRONTEND_URL=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=ai_data_analyst
MYSQL_USER=ai_data_analyst
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

DATABASE_URL=mysql+pymysql://ai_data_analyst:change-me@localhost:3306/ai_data_analyst

GROQ_API_KEY=replace-with-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

MAX_DATASET_SIZE_MB=250
UPLOAD_DIRECTORY=./storage/uploads

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
